__pycache__/
*.pyc
.venv/
.git/
# The raw CSVs are build-time only -- the container reads the .pkl, never them.
data/
# ...but data/external/ is NOT source data. It is the holiday calendar and site
# metadata, read at CALL TIME by forecast.calendar_lux, so the container cannot
# start without it. Negation must follow the exclusion above.
!data/external/
# ...and data/history/ for the same reason: it is the recent-count snapshot the
# lag service reads at CALL TIME to answer GET /forecast/{lead}h without a
# payload. Built by scripts/build_lag_history.py, not source data. Without this
# negation the `data/` rule above strips it from the build context and
# Dockerfile.lag's COPY fails the build outright.
!data/history/
*.ipynb
notebooks/

# build-time only -- the container reads the .pkl, never the source CSVs
scripts/
*.bak
models/*.bak

# local tooling
docker-compose.yml
postman_collection.json
*.md
